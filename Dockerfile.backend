# ==============================================================================
# Standalone Backend Dockerfile for Render / Cloud Containers
# ==============================================================================
FROM python:3.12-slim AS runner

# Optimize Python execution in containers
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_ENV=production \
    PORT=5000

# Install system dependencies:
# - tesseract-ocr & language data for medical scan optical character recognition
# - libgl1 & libglib2.0-0 for PyMuPDF / OpenCV / image operations
# - curl for container health check
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first for caching
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application backend source files
COPY app.py config.py ./
COPY core/ ./core/
COPY database/ ./database/
COPY routes/ ./routes/
COPY services/ ./services/
COPY templates/ ./templates/
COPY data/ ./data/

# Create runtime directories for SQLite database, report file uploads, and static assets
RUN mkdir -p /app/database /app/uploads /app/static

# Expose HTTP port
EXPOSE 5000

# Container healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Launch production WSGI application with Gunicorn (1 worker + 8 threads prevents SQLite locking and memory overflow)
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "8", "--timeout", "120", "app:app"]
