# ==============================================================================
# Backend Configuration (.env)
# ==============================================================================

# Core Flask & Security
SECRET_KEY=change-me-in-production-use-a-strong-random-secret
DATABASE_URL=sqlite:///database/medreport.db

# Cross-Origin (CORS) & Cookie Settings for Separated Deployment
# In production on Render + Vercel, set SESSION_COOKIE_SECURE=true and SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
# Comma-separated list of allowed frontend URLs:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# Gemini API Key (for report OCR, AI medical explanation, and translation)
GEMINI_API_KEY=

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Backend OAuth callback endpoint:
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
# Frontend redirect target after OAuth sign-in:
FRONTEND_URL=http://127.0.0.1:3000

# Local proxy & development server ports
FLASK_URL=http://127.0.0.1:5000
PORT=3000
